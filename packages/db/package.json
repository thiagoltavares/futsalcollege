{
  "name": "@futsalcollege/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:tipos": "supabase gen types typescript --local > src/tipos.ts",
    "typecheck": "tsc --noEmit",
    "test": "supabase status -o env > .env.test && dotenv -e .env.test -- vitest run"
  },
  "devDependencies": {
    "@futsalcollege/config": "workspace:*",
    "@supabase/supabase-js": "^2.112.4",
    "dotenv-cli": "^7.4.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
