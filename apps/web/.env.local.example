NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54521
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=cole-aqui-a-publishable-key-de-supabase-status

# Chave secreta (service_role) do Supabase local — só lida no servidor,
# nunca em código "use client". Hoje só alimenta o login de desenvolvimento
# abaixo (/entrar), que usa a Admin API para criar sessão sem link mágico.
# Pegue com `supabase status -o env` (campo SECRET_KEY, ou SERVICE_ROLE_KEY
# em CLIs mais antigas).
SUPABASE_SECRET_KEY=cole-aqui-a-secret-key-de-supabase-status

# Porta dos fundos de login para dado de criança: liga o seletor "entrar
# como" em /entrar, que troca de usuário sem passar pelo link mágico.
# NUNCA ligue isto fora da sua máquina de desenvolvimento — mesmo com esta
# variável em "1", o atalho só aparece quando NODE_ENV !== "production"
# (dupla trava, checada de novo no servidor antes de criar a sessão).
# Deixe "0" (ou remova a linha) em qualquer ambiente que não seja o seu
# localhost.
NEXT_PUBLIC_LOGIN_DEV=0

# Pré-lançamento (ver src/lib/preLancamento.ts). O site nasce FECHADO: só a
# home (página de "em breve" com a pesquisa) e o login são públicos.
# REVELA_ABERTO=1 abre tudo e devolve a vitrine para "/".
# REVELA_ABERTO=1
# E-mails da equipe que passam pela trava, separados por vírgula. Sem esta
# variável, em desenvolvimento qualquer conta logada passa; em produção,
# ninguém passa.
# EQUIPE_EMAILS=thiago@exemplo.com,flavio@exemplo.com
